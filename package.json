{
  "name": "painel",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gerenciamento centralizado de projetos e serviços",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api-central",
    "dev:web": "npm run dev -w apps/painel-web",
    "dev:api": "npm run dev -w apps/api-central",
    "dev:agente": "npm run dev -w apps/agente",
    "dev:tudo": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop all",
    "restart:pm2": "pm2 restart all",
    "status:pm2": "pm2 status",
    "logs:pm2": "pm2 logs",
    "save:pm2": "pm2 save",
    "prisma:generate": "npm run prisma:generate -w apps/api-central",
    "prisma:migrate": "npm run prisma:migrate -w apps/api-central",
    "prisma:deploy": "npm run prisma:deploy -w apps/api-central",
    "pm2:registrar-painel": "node scripts/registrar-painel.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules",
    "clean:all": "rimraf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
