# Variáveis de ambiente - Exemplo
# Copie este arquivo para .env e preencha os valores

# ===========================================
# CONFIGURAÇÕES GERAIS
# ===========================================

# Modo de operacao (desenvolvimento | producao)
NODE_ENV=desenvolvimento

# Porta do servidor
PORT=3001

# ===========================================
# BANCO DE DADOS
# ===========================================

# Credenciais do PostgreSQL (desenvolvimento local)
# USUARIO: postgres
# SENHA: admin
# PORTA: 5432
# BANCO: painel
DATABASE_URL="postgresql://postgres:admin@localhost:5432/painel?schema=public"

# ===========================================
# SEGURANÇA
# ===========================================

# Chave secreta para JWT (troque em producao!)
JWT_SECRET=painel-jwt-secret-desenvolvimento-2024

# Tempo de expiracao do token (em segundos) - 24 horas
JWT_EXPIRACAO=86400

# ===========================================
# API CENTRAL
# ===========================================

# URL da API Central (usado pelo agente)
API_URL=http://localhost:3001

# ===========================================
# AGENTE
# ===========================================

# Token de autenticacao do agente
# Este token deve ser gerado pela plataforma
# Exemplo: AGENT_TOKEN=painel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_TOKEN=

# URL da API para o agente conectar
AGENT_API_URL=http://localhost:3001

# ===========================================
# PAINEL WEB
# ===========================================

# URL da API (usado pelo frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
