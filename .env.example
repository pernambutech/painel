# Variáveis de ambiente - Exemplo
# Copie este arquivo para .env e preencha os valores

# ===========================================
# CONFIGURAÇÕES GERAIS
# ===========================================

# Modo de operacao (desenvolvimento | producao)
NODE_ENV=desenvolvimento

# Porta do servidor
PORT=3001

# ===========================================
# BANCO DE DADOS
# ===========================================

# URL de conexao com o PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/painel?schema=public"

# ===========================================
# SEGURANÇA
# ===========================================

# Chave secreta para JWT (troque em producao!)
JWT_SECRET=sua_chave_secreta_aqui

# Tempo de expiracao do token (em segundos)
JWT_EXPIRACAO=86400

# ===========================================
# API CENTRAL
# ===========================================

# URL da API Central (usado pelo agente)
API_URL=http://localhost:3001

# ===========================================
# AGENTE
# ===========================================

# Token de autenticacao do agente
# Este token deve ser gerado pela plataforma
AGENT_TOKEN=

# ===========================================
# PAINEL WEB
# ===========================================

# URL da API (usado pelo frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
