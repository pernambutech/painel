// Schema Prisma - Primeira versão do banco de dados
// Entidades: Usuários, Organizações, Associação usuário-organização, Ambientes, Agentes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USUÁRIO
// ===========================================

model Usuario {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String
  sobrenome      String?   @map("sobrenome")
  email          String    @unique
  senha          String
  avatar         String?   @map("avatar")
  cargo          String?   @map("cargo")
  timezone       String    @default("America/Sao_Paulo") @map("timezone")
  ultimoLoginEm  DateTime? @map("ultimo_login_em")
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  // Relacionamento com organizações
  membros MembroOrganizacao[]
  execucoes Execucao[]

  @@map("usuarios")
}

// ===========================================
// ORGANIZAÇÃO
// ===========================================

model Organizacao {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  slug         String   @unique
  preferencias Json?    // Aparência, configurações customizadas
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos
  membros   MembroOrganizacao[]
  ambientes Ambiente[]
  agentes   Agente[]
  projetos  Projeto[]
  servicos  Servico[]
  execucoes Execucao[]

  @@map("organizacoes")
}

model MembroOrganizacao {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  organizacaoId String   @map("organizacao_id") @db.Uuid
  papel         String   @default("membro") // proprietario, admin, membro
  criadoEm      DateTime @default(now()) @map("criado_em")

  // Relacionamentos
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  // Constraint de unicidade
  @@unique([usuarioId, organizacaoId])
  @@map("membros_organizacoes")
}

// ===========================================
// AMBIENTE
// ===========================================

model Ambiente {
  id                 String    @id @default(uuid()) @db.Uuid
  nome               String
  tipo               String    @default("local") // local, desenvolvimento, homologacao, producao
  sistemaOperacional String    @default("linux") // windows, linux, macos
  organizacaoId      String    @map("organizacao_id") @db.Uuid
  ativo              Boolean   @default(true)
  deletadoEm         DateTime? @map("deletado_em")
  criadoEm           DateTime  @default(now()) @map("criado_em")
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em")

  // Relacionamento
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  // Relacionamento com agentes
  agentes Agente[]
  servicos Servico[]
  execucoes Execucao[]

  @@map("ambientes")
}

// ===========================================
// AGENTE
// ===========================================

model Agente {
  id                   String    @id @default(uuid()) @db.Uuid
  nome                 String
  token                String    @unique
  status               String    @default("offline") // online, offline, manutencao
  ultimoHeartbeat      DateTime? @map("ultimo_heartbeat")
  versao               String?
  sistemaOperacional   String?   @default("linux") @map("sistema_operacional")
  cpuUso               Float?    @map("cpu_uso")
  memoriaUso           Float?    @map("memoria_uso")
  memoriaTotal         Float?    @map("memoria_total")
  uptime               Int?
  processosTotal       Int?      @default(0) @map("processos_total")
  processosOnline      Int?      @default(0) @map("processos_online")
  processosParados     Int?      @default(0) @map("processos_parados")
  processosErro        Int?      @default(0) @map("processos_erro")
  diretoriosAutorizados Json?     @default("[]") @map("diretorios_autorizados") // JSON array de paths permitidos
  ambienteId           String    @map("ambiente_id") @db.Uuid
  organizacaoId        String    @map("organizacao_id") @db.Uuid
  ativo                Boolean   @default(true)
  criadoEm             DateTime  @default(now()) @map("criado_em")
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em")

  // Relacionamentos
  ambiente    Ambiente    @relation(fields: [ambienteId], references: [id], onDelete: Cascade)
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("agentes")
}

// ===========================================
// PROJETO
// ===========================================

model Projeto {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String
  descricao      String?
  organizacaoId  String    @map("organizacao_id") @db.Uuid
  ativo          Boolean   @default(true)
  deletadoEm     DateTime? @map("deletado_em")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  // Relacionamentos
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  servicos    Servico[]
  execucoes   Execucao[]

  @@index([organizacaoId])
  @@map("projetos")
}

// ===========================================
// SERVIÇO
// ===========================================

model Servico {
  id                String    @id @default(uuid()) @db.Uuid
  nome              String
  tipo              String    @default("custom") // frontend, backend, api, worker, bot, custom
  diretorio         String?
  comando           String?
  porta             Int?
  variaveisAmbiente Json?     @map("variaveis_ambiente") // { "KEY": "value", ... }
  healthCheckUrl    String?   @map("health_check_url") // endpoint de health check (ex: /api/health)
  projetoId         String    @map("projeto_id") @db.Uuid
  ambienteId        String?   @map("ambiente_id") @db.Uuid
  organizacaoId     String    @map("organizacao_id") @db.Uuid
  ativo             Boolean   @default(true)
  deletadoEm        DateTime? @map("deletado_em")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  // Relacionamentos
  projeto     Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  ambiente    Ambiente?   @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  execucoes   Execucao[]

  @@index([projetoId])
  @@index([ambienteId])
  @@index([organizacaoId])
  @@map("servicos")
}

// ===========================================
// EXECUÇÃO / HISTÓRICO
// ===========================================

model Execucao {
  id            String   @id @default(uuid()) @db.Uuid
  organizacaoId String   @map("organizacao_id") @db.Uuid
  projetoId     String?  @map("projeto_id") @db.Uuid
  servicoId     String   @map("servico_id") @db.Uuid
  ambienteId    String?  @map("ambiente_id") @db.Uuid
  acao          String // iniciar, parar, reiniciar
  status        String   @default("pendente") // pendente, sucesso, falhou
  resultado     Json?
  erro          String?
  usuarioId     String   @map("usuario_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  // Relacionamentos
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  projeto     Projeto?    @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  servico     Servico     @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  ambiente    Ambiente?   @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
  @@index([servicoId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("execucoes")
}
